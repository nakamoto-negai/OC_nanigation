# 本番環境用の環境変数
# このファイルをコピーして .env.prod を作成し、値を設定してください
# cp .env.prod.example .env.prod

# データベース認証情報（必ず変更してください）
DB_USER=nav
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_NAME=navigation

# 管理者認証（必ず変更してください）
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
ADMIN_SECRET=CHANGE_THIS_RANDOM_SECRET_STRING
# 食堂編集用アカウント（食堂の混雑度だけを編集できる。ADMIN_PASSWORD と別の値にすること）
CAFETERIA_PASSWORD=CHANGE_THIS_CAFETERIA_PASSWORD

# SSL証明書のパス（サーバー上の絶対パス）
SSL_CERT_FILE=/etc/ssl/certs/server.crt
SSL_KEY_FILE=/etc/ssl/private/server.key
